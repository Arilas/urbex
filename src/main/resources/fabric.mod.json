{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Procedural abandoned-city worldgen. A fork of Lost Cities by McJty.",
  "authors": ["Oleksandr Hanzha"],
  "contributors": ["McJty (original Lost Cities)"],
  "contact": {
    "homepage": "https://github.com/Arilas/urbex",
    "issues": "https://github.com/Arilas/urbex/issues",
    "sources": "https://github.com/Arilas/urbex"
  },
  "license": "MIT",
  "environment": "*",
  "accessWidener": "META-INF/${mod_id}.accesswidener",
  "entrypoints": {
    "main": ["dev.krona.urbex.Urbex"],
    "client": ["dev.krona.urbex.setup.ClientSetup"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
